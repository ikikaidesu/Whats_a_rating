<Window x:Class="movieRateGuess.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:movieRateGuess"
        mc:Ignorable="d"
        Title="MainWindow" Height="1080" Width="1920" WindowState="Maximized">
    <Grid>
        <Border>
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#206ABE" Offset="0.0"/>
                    <GradientStop Color="#D500FF" Offset="1.0"/>
                </LinearGradientBrush>
            </Border.Background>

            <ContentControl  Content="{Binding CurrentView}"/>
            
        </Border>
    </Grid>
</Window>
