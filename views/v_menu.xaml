<UserControl x:Class="movieRateGuess.views.v_menu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:movieRateGuess.views"
             xmlns:el="clr-namespace:movieRateGuess.views.elements"
             mc:Ignorable="d"
             MinHeight="1080" MinWidth="1920">
    <Grid>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0"
                       Text="Насколько хорошо ты сможешь угадать оценки&#10;популярных фильмов?"
                       FontSize="48"
                       Foreground="White"
                       Margin="0,50,0,0"
                       TextAlignment="Center"/>
            <Grid Grid.Row="1"
                  Margin="0,75,0,0"
                  HorizontalAlignment="Center">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <ContentControl Grid.Column="0"
                                Content="{Binding GameModeCard}"/>

                <ContentControl Grid.Column="2"
                                Content="{Binding GameModeFriendCard}"/>

            </Grid>
        </Grid>

        <el:v_helpWindow HorizontalAlignment="Right"
                         VerticalAlignment="Top"
                         Margin="0,25,50,0"
                         Visibility="{Binding IsHelpWindowOpen, Converter={StaticResource boolToVisibilityConventer}}" 
                         helpText="{Binding HelpTextInvalidLink}"
                         closeCommand="{Binding closeHelpWindowCommand}"/>
    </Grid>
</UserControl>
