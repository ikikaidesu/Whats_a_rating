<UserControl x:Class="movieRateGuess.views.v_results"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:movieRateGuess.views"
             mc:Ignorable="d" 
         MinHeight="1080" MinWidth="1920">
    <Grid HorizontalAlignment="Center"
          VerticalAlignment="Center">
        <StackPanel>
            <TextBlock Text="Игра окончена!&#x0a;Ваши результаты( •̀ᴗ•́ ) ̑̑و"
                       Style="{StaticResource textblock_results}"/>
            <TextBlock Text="{Binding filmAmount, StringFormat=Кол-во фильмов: {0}}"
                       d:Text="Кол-во фильмов: 20"
                       Margin="0,35,0,0"
                       Style="{StaticResource textblock_results}"/>
            <TextBlock Text="{Binding score, StringFormat=Очки: {0}}"
                       d:Text="Очки: 20"
                       Style="{StaticResource textblock_results}"/>
            <TextBlock Text="{Binding time, StringFormat=Время: {0:mm\\:ss} мин.}"
                       d:Text="Время: 00:00 мин."
                       Style="{StaticResource textblock_results}"/>

            <Button Style="{StaticResource button_transparent}"
                    Command="{Binding goBackCommand}"
                    Margin="0,50,0,0">
                <Border Width="64"
                        Height="64"
                        CornerRadius="50"
                        Padding="10"
                        Background="#22201E">
                    <Path Data="{StaticResource iconBack}"
                                  Name="questionIcon"
                                  Fill="White"
                                  Stroke="White"
                                  StrokeThickness="2.3"
                                  Stretch="Uniform"/>
                </Border>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
