<UserControl x:Class="movieRateGuess.views.elements.v_popUpOnMouseEnter"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:movieRateGuess.views.elements"
             x:Name="showTooltipOnMouseEnterUserControl"
             mc:Ignorable="d" >
    <Grid Width="72" 
          Height="72"
          MouseEnter="Border_MouseEnter"
          MouseLeave="Border_MouseLeave">
        <Rectangle Width="35"
                   Height="45"
                   Fill="White"/>

        <Path Data="{StaticResource iconQuestion}"
              Name="questionIcon"
              Fill="Red"
              Stretch="Uniform"/>

        <Popup Name="ToolTip"
               PlacementTarget="{Binding ElementName=questionIcon}"
               HorizontalAlignment="Center" 
               HorizontalOffset="{Binding ToolTipHorizontalOffset, ElementName=showTooltipOnMouseEnterUserControl}"
               VerticalOffset="{Binding ToolTipVerticalOffset, ElementName=showTooltipOnMouseEnterUserControl}"
               Placement="Bottom"
               StaysOpen="False"
               AllowsTransparency="True"
               PopupAnimation="Fade">
            <StackPanel Orientation="Vertical">
                <Border Style="{StaticResource border_showTooltipOnMouseEnter}"
                            Width="{Binding ToolTipWidth, ElementName=showTooltipOnMouseEnterUserControl}"
                            Height="{Binding ToolTipHeight, ElementName=showTooltipOnMouseEnterUserControl}">
                    <TextBlock Text="{Binding ToolTipText, ElementName=showTooltipOnMouseEnterUserControl}"
                                   Style="{StaticResource textblock_showToolTipOnMouseEnter}"/>
                </Border>
                <!-- треугольничек -->
                <Polygon Points="-5,0 5,0 0,10"
                             Fill="Black" 
                             Stroke="Black" 
                             StrokeThickness="2"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"/>
            </StackPanel>
        </Popup>
    </Grid>
</UserControl>
