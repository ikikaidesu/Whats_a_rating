<UserControl x:Class="movieRateGuess.views.elements.v_helpWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:movieRateGuess.views.elements"
             x:Name="helpWindow"
             mc:Ignorable="d">
    <Border CornerRadius="10"
            Background="#22201ECC"
            MaxWidth="500">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="auto"/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Боковая полоска -->
            <Border Background="Red"
                Grid.Column="0"
                CornerRadius="10,0,0,10"/>

            <!-- Основной контент -->
            <TextBlock Text="{Binding helpText, ElementName=helpWindow}"
                       TextWrapping="Wrap"
                       Grid.Column="1"
                       Foreground="White"
                       FontSize="16"
                       Margin="10,10,15,10"/>
            <Button Grid.Column="2"
                    Style="{StaticResource button_transparent}"
                    Height="16"
                    Width="16"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,10,10,0"
                    Command="{Binding closeCommand, ElementName=helpWindow}">
                <Border>
                    <Path Data="{StaticResource iconClose}"
                      Name="questionIcon"
                      Stroke="White"
                      StrokeThickness="0.8"
                      Stretch="Uniform"/>
                </Border>
            </Button>

        </Grid>
    </Border>
</UserControl>
